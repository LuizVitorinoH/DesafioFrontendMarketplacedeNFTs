    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.58.0",
    "msw": "^2.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "socket.io-client": "^4.8.4",
